rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validTimestamp() { return request.resource.data.updatedAt == request.time; }

    match /users/{uid} {
      allow read, create, update, delete: if owner(uid);
    }

    match /users/{uid}/{collection}/{docId} {
      allow read, create, update, delete: if owner(uid);
    }

    match /nutritionistConnections/{connectionId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.nutritionistId == request.auth.uid);
    }

    match /nutritionistMessages/{messageId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
